<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme tokens. Dark and Light define exactly the same keys; all UI references them via DynamicResource so the theme can switch live. -->
    <Color x:Key="BgWindowColor">#F2F4F7</Color>
    <Color x:Key="BgSidebarColor">#FFFFFF</Color>
    <Color x:Key="BgCardColor">#FFFFFF</Color>
    <Color x:Key="BgInsetColor">#F5F7FA</Color>
    <Color x:Key="BgNavyColor">#EDF3F9</Color>
    <Color x:Key="BgHoverColor">#E9EDF2</Color>
    <Color x:Key="BgPressedColor">#DDE3EA</Color>
    <Color x:Key="LineSubtleColor">#E1E6EC</Color>
    <Color x:Key="LineStrongColor">#C9D1DB</Color>
    <Color x:Key="TextPrimaryColor">#0E1621</Color>
    <Color x:Key="TextSecondaryColor">#4A5666</Color>
    <Color x:Key="TextMutedColor">#6F7B89</Color>
    <Color x:Key="AccentColor">#08776E</Color>
    <Color x:Key="AccentHoverColor">#066A62</Color>
    <Color x:Key="AccentPressedColor">#055A53</Color>
    <Color x:Key="AccentSoftColor">#1A08776E</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="HighlightColor">#1476A8</Color>
    <Color x:Key="GoodColor">#16864F</Color>
    <Color x:Key="GoodSoftColor">#1A16864F</Color>
    <Color x:Key="WarnColor">#9A6100</Color>
    <Color x:Key="WarnSoftColor">#1F9A6100</Color>
    <Color x:Key="BadColor">#C0303D</Color>
    <Color x:Key="BadSoftColor">#1AC0303D</Color>
    <Color x:Key="InfoCColor">#1F63B8</Color>
    <Color x:Key="InfoSoftColor">#1A1F63B8</Color>
    <Color x:Key="ChartGridColor">#E6EAF0</Color>
    <Color x:Key="ChartCpuColor">#08776E</Color>
    <Color x:Key="ChartMemoryColor">#6A55E0</Color>
    <Color x:Key="ChartDiskColor">#C27A00</Color>
    <Color x:Key="ChartTempColor">#C0303D</Color>
    <Color x:Key="TrackBgColor">#DCE2E9</Color>
    <Color x:Key="OverlayColor">#990E1621</Color>

    <SolidColorBrush x:Key="BgWindow" Color="#F2F4F7" />
    <SolidColorBrush x:Key="BgSidebar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgInset" Color="#F5F7FA" />
    <SolidColorBrush x:Key="BgNavy" Color="#EDF3F9" />
    <SolidColorBrush x:Key="BgHover" Color="#E9EDF2" />
    <SolidColorBrush x:Key="BgPressed" Color="#DDE3EA" />
    <SolidColorBrush x:Key="LineSubtle" Color="#E1E6EC" />
    <SolidColorBrush x:Key="LineStrong" Color="#C9D1DB" />
    <SolidColorBrush x:Key="TextPrimary" Color="#0E1621" />
    <SolidColorBrush x:Key="TextSecondary" Color="#4A5666" />
    <SolidColorBrush x:Key="TextMuted" Color="#6F7B89" />
    <SolidColorBrush x:Key="Accent" Color="#08776E" />
    <SolidColorBrush x:Key="AccentHover" Color="#066A62" />
    <SolidColorBrush x:Key="AccentPressed" Color="#055A53" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1A08776E" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Highlight" Color="#1476A8" />
    <SolidColorBrush x:Key="Good" Color="#16864F" />
    <SolidColorBrush x:Key="GoodSoft" Color="#1A16864F" />
    <SolidColorBrush x:Key="Warn" Color="#9A6100" />
    <SolidColorBrush x:Key="WarnSoft" Color="#1F9A6100" />
    <SolidColorBrush x:Key="Bad" Color="#C0303D" />
    <SolidColorBrush x:Key="BadSoft" Color="#1AC0303D" />
    <SolidColorBrush x:Key="InfoC" Color="#1F63B8" />
    <SolidColorBrush x:Key="InfoSoft" Color="#1A1F63B8" />
    <SolidColorBrush x:Key="ChartGrid" Color="#E6EAF0" />
    <SolidColorBrush x:Key="ChartCpu" Color="#08776E" />
    <SolidColorBrush x:Key="ChartMemory" Color="#6A55E0" />
    <SolidColorBrush x:Key="ChartDisk" Color="#C27A00" />
    <SolidColorBrush x:Key="ChartTemp" Color="#C0303D" />
    <SolidColorBrush x:Key="TrackBg" Color="#DCE2E9" />
    <SolidColorBrush x:Key="Overlay" Color="#990E1621" />

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E3F4F2" />
        <GradientStop Offset="1" Color="#F2F4F7" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F5FBFA" />
        <GradientStop Offset="1" Color="#FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#08776E" />
        <GradientStop Offset="1" Color="#1476A8" />
    </LinearGradientBrush>
</ResourceDictionary>
