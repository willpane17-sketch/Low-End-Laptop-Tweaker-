<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme tokens. Dark and Light define exactly the same keys; all UI references them via DynamicResource so the theme can switch live. -->
    <Color x:Key="BgWindowColor">#0D1015</Color>
    <Color x:Key="BgSidebarColor">#0A0D12</Color>
    <Color x:Key="BgCardColor">#141920</Color>
    <Color x:Key="BgInsetColor">#1A2029</Color>
    <Color x:Key="BgNavyColor">#0F1A29</Color>
    <Color x:Key="BgHoverColor">#212833</Color>
    <Color x:Key="BgPressedColor">#2A3340</Color>
    <Color x:Key="LineSubtleColor">#222A35</Color>
    <Color x:Key="LineStrongColor">#303A48</Color>
    <Color x:Key="TextPrimaryColor">#E8EDF3</Color>
    <Color x:Key="TextSecondaryColor">#A3AFBD</Color>
    <Color x:Key="TextMutedColor">#6D7A89</Color>
    <Color x:Key="AccentColor">#17C8B8</Color>
    <Color x:Key="AccentHoverColor">#2ADBCB</Color>
    <Color x:Key="AccentPressedColor">#11A699</Color>
    <Color x:Key="AccentSoftColor">#2217C8B8</Color>
    <Color x:Key="AccentTextColor">#04201D</Color>
    <Color x:Key="HighlightColor">#62D9F6</Color>
    <Color x:Key="GoodColor">#3FD68E</Color>
    <Color x:Key="GoodSoftColor">#1F3FD68E</Color>
    <Color x:Key="WarnColor">#F4BC4F</Color>
    <Color x:Key="WarnSoftColor">#22F4BC4F</Color>
    <Color x:Key="BadColor">#F2656F</Color>
    <Color x:Key="BadSoftColor">#22F2656F</Color>
    <Color x:Key="InfoCColor">#63A9F6</Color>
    <Color x:Key="InfoSoftColor">#2263A9F6</Color>
    <Color x:Key="ChartGridColor">#1E2631</Color>
    <Color x:Key="ChartCpuColor">#17C8B8</Color>
    <Color x:Key="ChartMemoryColor">#8B7CF6</Color>
    <Color x:Key="ChartDiskColor">#F4BC4F</Color>
    <Color x:Key="ChartTempColor">#F2656F</Color>
    <Color x:Key="TrackBgColor">#262F3B</Color>
    <Color x:Key="OverlayColor">#CC05080C</Color>

    <SolidColorBrush x:Key="BgWindow" Color="#0D1015" />
    <SolidColorBrush x:Key="BgSidebar" Color="#0A0D12" />
    <SolidColorBrush x:Key="BgCard" Color="#141920" />
    <SolidColorBrush x:Key="BgInset" Color="#1A2029" />
    <SolidColorBrush x:Key="BgNavy" Color="#0F1A29" />
    <SolidColorBrush x:Key="BgHover" Color="#212833" />
    <SolidColorBrush x:Key="BgPressed" Color="#2A3340" />
    <SolidColorBrush x:Key="LineSubtle" Color="#222A35" />
    <SolidColorBrush x:Key="LineStrong" Color="#303A48" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E8EDF3" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A3AFBD" />
    <SolidColorBrush x:Key="TextMuted" Color="#6D7A89" />
    <SolidColorBrush x:Key="Accent" Color="#17C8B8" />
    <SolidColorBrush x:Key="AccentHover" Color="#2ADBCB" />
    <SolidColorBrush x:Key="AccentPressed" Color="#11A699" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2217C8B8" />
    <SolidColorBrush x:Key="AccentText" Color="#04201D" />
    <SolidColorBrush x:Key="Highlight" Color="#62D9F6" />
    <SolidColorBrush x:Key="Good" Color="#3FD68E" />
    <SolidColorBrush x:Key="GoodSoft" Color="#1F3FD68E" />
    <SolidColorBrush x:Key="Warn" Color="#F4BC4F" />
    <SolidColorBrush x:Key="WarnSoft" Color="#22F4BC4F" />
    <SolidColorBrush x:Key="Bad" Color="#F2656F" />
    <SolidColorBrush x:Key="BadSoft" Color="#22F2656F" />
    <SolidColorBrush x:Key="InfoC" Color="#63A9F6" />
    <SolidColorBrush x:Key="InfoSoft" Color="#2263A9F6" />
    <SolidColorBrush x:Key="ChartGrid" Color="#1E2631" />
    <SolidColorBrush x:Key="ChartCpu" Color="#17C8B8" />
    <SolidColorBrush x:Key="ChartMemory" Color="#8B7CF6" />
    <SolidColorBrush x:Key="ChartDisk" Color="#F4BC4F" />
    <SolidColorBrush x:Key="ChartTemp" Color="#F2656F" />
    <SolidColorBrush x:Key="TrackBg" Color="#262F3B" />
    <SolidColorBrush x:Key="Overlay" Color="#CC05080C" />

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#10263A" />
        <GradientStop Offset="1" Color="#0D1015" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0F1C26" />
        <GradientStop Offset="1" Color="#0A0D12" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#17C8B8" />
        <GradientStop Offset="1" Color="#62D9F6" />
    </LinearGradientBrush>
</ResourceDictionary>
