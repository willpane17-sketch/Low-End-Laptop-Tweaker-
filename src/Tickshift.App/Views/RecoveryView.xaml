<UserControl x:Class="Tickshift.App.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tickshift.App.Controls"
             xmlns:local="clr-namespace:Tickshift.App.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="ChangeRow">
            <Border Style="{StaticResource Inset}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:StatusBadge Text="{Binding Status, Converter={StaticResource Friendly}}" Kind="{Binding Status, Converter={StaticResource BadgeKind}}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                            <Run Text="{Binding Timestamp, Mode=OneWay, Converter={StaticResource Time}}" /><Run Text="  ·  " /><Run Text="{Binding Source, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Target, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0">
                            <Run Text="Original: " /><Run Text="{Binding OriginalValue, Mode=OneWay, TargetNullValue='—'}" Foreground="{DynamicResource TextPrimary}" /><Run Text="    New: " /><Run Text="{Binding NewValue, Mode=OneWay, TargetNullValue='—'}" Foreground="{DynamicResource TextPrimary}" /><Run Text="    Reversible: " /><Run Text="{Binding Reversible, Mode=OneWay}" Foreground="{DynamicResource TextPrimary}" />
                        </TextBlock>
                        <TextBlock Text="{Binding VerificationMessage}" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="{Binding VerificationMessage, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" Foreground="{DynamicResource Warn}" Margin="0,2,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding IsActiveReversible, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Undo}" Width="14" Height="14" />
                            <TextBlock Text="Restore" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Text="Recovery Centre" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,18"
                       Text="Every change TICKSHIFT makes is recorded before it happens, with the original value, the new value and whether it was verified. Restore any reversible change here." />

            <local:PageStatus />

            <c:ResponsiveGrid MinColumnWidth="300" MaxColumns="2" Spacing="{DynamicResource GridSpacing}" Margin="{DynamicResource CardMargin}">
                <Border Style="{StaticResource HeroCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Restore previous configuration" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,12"
                                   Text="Undo the most recent optimisation, or restore everything TICKSHIFT changed (recommended before uninstalling)." />
                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding UndoLastCommand}" Margin="0,0,10,6">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Undo}" Width="14" Height="14" />
                                    <TextBlock Text="Undo last optimisation" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Content="Restore everything…" Command="{Binding RestoreAllCommand}" Margin="0,0,10,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Windows restore point" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding RestorePointText}" Style="{StaticResource Secondary}" Margin="0,6,0,12" />
                        <WrapPanel>
                            <Button Content="Create restore point now" Command="{Binding CreateRestorePointCommand}" IsEnabled="{Binding RestorePointAvailable}" Margin="0,0,10,6" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Asks for administrator approval. Windows creates at most one every 24 hours; TICKSHIFT reports when it was skipped." />
                    </StackPanel>
                </Border>
            </c:ResponsiveGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding ExportReportCommand}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Export}" Width="14" Height="14" />
                                    <TextBlock Text="Export diagnostic report" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="RecoveryTab" Content="Changed settings" IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=Active}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="RecoveryTab" Content="History" IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="RecoveryTab" Content="Failed operations" IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=Failed}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="RecoveryTab" Content="Optimisation runs" IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=Runs}" />
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <StackPanel Visibility="{Binding Tab, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=Active}">
                        <TextBlock Text="No reversible changes are currently in effect." Style="{StaticResource Secondary}" Visibility="{Binding Active.Count, Converter={StaticResource Collapsed}}" />
                        <ItemsControl ItemsSource="{Binding Active}" ItemTemplate="{StaticResource ChangeRow}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Tab, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=All}">
                        <TextBlock Text="No changes recorded yet." Style="{StaticResource Secondary}" Visibility="{Binding AllChanges.Count, Converter={StaticResource Collapsed}}" />
                        <ItemsControl ItemsSource="{Binding AllChanges}" ItemTemplate="{StaticResource ChangeRow}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Tab, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=Failed}">
                        <TextBlock Text="No failed operations." Style="{StaticResource Secondary}" Visibility="{Binding Failed.Count, Converter={StaticResource Collapsed}}" />
                        <ItemsControl ItemsSource="{Binding Failed}" ItemTemplate="{StaticResource ChangeRow}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Tab, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=Runs}">
                        <TextBlock Text="No optimisation runs yet." Style="{StaticResource Secondary}" Visibility="{Binding Runs.Count, Converter={StaticResource Collapsed}}" />
                        <ItemsControl ItemsSource="{Binding Runs}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Inset}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding StartedAt, Mode=OneWay, Converter={StaticResource Time}}" /><Run Text="  ·  " /><Run Text="{Binding Source, Mode=OneWay}" /><Run Text="  ·  preset " /><Run Text="{Binding Preset, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,6">
                                                <Run Text="{Binding VerifiedCount, Mode=OneWay}" /><Run Text=" verified · " /><Run Text="{Binding FailedCount, Mode=OneWay}" /><Run Text=" not verified or failed · dry run: " /><Run Text="{Binding DryRun, Mode=OneWay}" /><Run Text=" · cancelled: " /><Run Text="{Binding Cancelled, Mode=OneWay}" />
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,2">
                                                            <Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource Friendly}}" Foreground="{DynamicResource TextSecondary}" /><Run Text=" — " /><Run Text="{Binding Title, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="{Binding RestorePointMessage, Converter={StaticResource Visible}}">
                                                <Run Text="Restore point: " /><Run Text="{Binding RestorePointMessage, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource NoticeInfo}">
                <StackPanel>
                    <TextBlock Text="Before uninstalling" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                               Text="Select “Restore everything” above, then uninstall from Settings › Apps. Deleted temporary files cannot be restored (they were disposable). Uninstalling also removes TICKSHIFT's Launch with Windows entry." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
