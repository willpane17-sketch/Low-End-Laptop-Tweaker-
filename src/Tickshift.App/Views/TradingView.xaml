<UserControl x:Class="Tickshift.App.Views.TradingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tickshift.App.Controls"
             xmlns:local="clr-namespace:Tickshift.App.Views">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Text="Trading Mode" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,18"
                       Text="A calmer system while you trade: protected apps, deferred maintenance, safe temporary settings and pressure alerts. Everything is restored when you finish." />

            <local:PageStatus />

            <!-- Hero -->
            <Border Style="{StaticResource HeroCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding StateText}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" Margin="12,0,0,0"
                                       AutomationProperties.LiveSetting="Assertive">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveSince}" Style="{StaticResource Caption}" Margin="24,4,0,0" />
                        <TextBlock Text="{Binding ActivationStep}" Style="{StaticResource Secondary}" Margin="24,8,0,0" Visibility="{Binding ActivationStep, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Padding="24,12,24,12"
                                Visibility="{Binding IsActive, Converter={StaticResource Collapsed}}" IsEnabled="{Binding IsTransitioning, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Play}" Width="16" Height="16" />
                                <TextBlock Text="Start Trading Mode" Margin="10,0,0,0" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding EndCommand}" Padding="24,12,24,12"
                                Visibility="{Binding IsActive, Converter={StaticResource Visible}}" IsEnabled="{Binding IsTransitioning, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Stop}" Width="16" Height="16" />
                                <TextBlock Text="End Trading Mode" Margin="10,0,0,0" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live status while active -->
            <c:ResponsiveGrid MinColumnWidth="200" MaxColumns="4" Spacing="{DynamicResource GridSpacing}" Margin="{DynamicResource CardMargin}"
                              Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="CPU LOAD" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource BigValue}" />
                        <c:StatusBadge Text="{Binding CpuPressure}" Kind="{Binding CpuPressure, Converter={StaticResource BadgeKind}}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="MEMORY PRESSURE" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource BigValue}" />
                        <c:StatusBadge Text="{Binding MemoryPressure}" Kind="{Binding MemoryPressure, Converter={StaticResource BadgeKind}}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="BROWSERS" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding BrowserText}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="THERMAL" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding ThermalText}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </c:ResponsiveGrid>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="Protected applications" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="No protected applications are selected." Style="{StaticResource Secondary}" Visibility="{Binding ProtectedStatuses.Count, Converter={StaticResource Collapsed}}" />
                    <ItemsControl ItemsSource="{Binding ProtectedStatuses}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                    <DockPanel>
                                        <c:StatusBadge DockPanel.Dock="Right" Text="{Binding StatusText}" Kind="{Binding Running, Converter={StaticResource BadgeKind}}" />
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Data="{StaticResource Icon.Lock}" Width="15" Height="15" Foreground="{DynamicResource Accent}" />
                                            <TextBlock Text="{Binding App.DisplayName}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Network" Style="{StaticResource CardTitle}" Margin="0,14,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Test connection" Command="{Binding TestNetworkCommand}" IsEnabled="{Binding IsTestingNetwork, Converter={StaticResource Not}}" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding NetworkText}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Network latency to a host is not your broker's execution time." Style="{StaticResource Caption}" Margin="0,4,0,0" />

                    <StackPanel Visibility="{Binding CloseSuggestions.Count, Converter={StaticResource Visible}}">
                        <TextBlock Text="Consider closing" Style="{StaticResource CardTitle}" Margin="0,16,0,4" />
                        <TextBlock Text="These non-protected apps are using significant resources. TICKSHIFT only asks an app to close if you choose to — it never force-terminates anything." Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding CloseSuggestions}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Ask to close…" Command="{Binding DataContext.AskToCloseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding CpuPercent, Mode=OneWay, StringFormat='{}{0:0}% CPU'}" Foreground="{DynamicResource TextSecondary}" /><Run Text="  ·  " Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding MemoryBytes, Mode=OneWay, Converter={StaticResource Bytes}}" Foreground="{DynamicResource TextSecondary}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding AppliedChanges.Count, Converter={StaticResource Visible}}">
                        <TextBlock Text="Temporary changes (restored when Trading Mode ends)" Style="{StaticResource CardTitle}" Margin="0,16,0,6" />
                        <ItemsControl ItemsSource="{Binding AppliedChanges}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='✓ {0}'}" Style="{StaticResource Secondary}" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Options (before starting) -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsActive, Converter={StaticResource Collapsed}}">
                <StackPanel>
                    <TextBlock Text="Temporary optimisations" Style="{StaticResource SectionTitle}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AdjustPowerPlan}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Adjust the power plan while plugged in" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Text="Switches Power saver to Balanced, and Balanced to High performance where available. Benefit varies by laptop and can increase heat; never applied on battery. Restored afterwards." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReduceAnimations}">
                        <StackPanel>
                            <TextBlock Text="Reduce Windows animations" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Text="Makes windows and menus respond instantly. Restored afterwards." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Protected applications -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding AddCustomAppCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Plus}" Width="14" Height="14" />
                                <TextBlock Text="Add application…" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Protected applications" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="Protected apps are never closed or restarted by TICKSHIFT and are excluded from close suggestions." Style="{StaticResource Caption}" Margin="0,2,0,10" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsProtected}" AutomationProperties.Name="{Binding Name}">
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Executable, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <c:StatusBadge Grid.Column="1" Text="{Binding Status}" Kind="{Binding IsRunning, Converter={StaticResource BadgeKind}}" Margin="12,0,0,0" />
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="6"
                                                Command="{Binding DataContext.RemoveCustomAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsCustom, Converter={StaticResource Visible}}" AutomationProperties.Name="Remove custom application">
                                            <c:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Safety notice -->
            <Border Style="{StaticResource NoticeInfo}">
                <StackPanel>
                    <TextBlock Text="What Trading Mode will never do" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                               Text="Terminate or restart trading applications · interact with brokers, accounts, positions or orders · change process priorities · disable security features · reset the network. It cannot make your broker execute faster — it helps your laptop stay responsive." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
