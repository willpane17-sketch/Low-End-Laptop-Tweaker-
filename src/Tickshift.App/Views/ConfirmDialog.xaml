<Window x:Class="Tickshift.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Tickshift.App.Controls"
        Width="520" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
        <DockPanel Margin="24,22,24,20">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Border x:Name="IconHost" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                    <c:Icon x:Name="HeaderIcon" Data="{StaticResource Icon.Shield}" Foreground="{DynamicResource Accent}" Width="18" Height="18" />
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" Margin="14,6,0,0" MaxWidth="420" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" IsCancel="True" Click="OnCancel" MinWidth="96" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConfirm" Margin="10,0,0,0" MinWidth="120" />
            </StackPanel>

            <CheckBox x:Name="Acknowledge" DockPanel.Dock="Bottom" Margin="0,14,0,0" Visibility="Collapsed" Checked="OnAcknowledgeChanged" Unchecked="OnAcknowledgeChanged">
                <TextBlock x:Name="AcknowledgeText" TextWrapping="Wrap" />
            </CheckBox>

            <ScrollViewer Style="{StaticResource PageScroll}" MaxHeight="420">
                <StackPanel>
                    <TextBlock x:Name="MessageText" Style="{StaticResource Secondary}" />
                    <ItemsControl x:Name="DetailsList" Margin="0,12,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
