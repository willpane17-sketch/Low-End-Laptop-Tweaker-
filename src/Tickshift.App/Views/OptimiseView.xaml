<UserControl x:Class="Tickshift.App.Views.OptimiseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tickshift.App.Controls"
             xmlns:local="clr-namespace:Tickshift.App.Views">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Text="One-Click Optimise" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,18"
                       Text="Analyse, snapshot, review, apply, verify and measure — every change is explained first, recorded, verified and (where possible) reversible." />

            <local:PageStatus />

            <Border Style="{StaticResource NoticeWarn}" Visibility="{Binding TradingActive, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource Body}" Text="Trading Mode is active. Disruptive items such as cache cleanup are deferred until it ends." />
            </Border>

            <!-- Preset selection -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Choose a preset" Style="{StaticResource SectionTitle}" />
                    <c:ResponsiveGrid MinColumnWidth="220" MaxColumns="3" Spacing="{DynamicResource GridSpacing}">
                        <RadioButton Style="{StaticResource OptionCard}" GroupName="Preset" IsChecked="{Binding Preset, Converter={StaticResource EnumEquals}, ConverterParameter=Safe}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Shield}" Foreground="{DynamicResource Good}" />
                                    <TextBlock Text="Safe" Style="{StaticResource CardTitle}" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Conservative, compatibility first." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource OptionCard}" GroupName="Preset" IsChecked="{Binding Preset, Converter={StaticResource EnumEquals}, ConverterParameter=Balanced}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Bolt}" Foreground="{DynamicResource InfoC}" />
                                    <TextBlock Text="Balanced" Style="{StaticResource CardTitle}" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Adds reversible, explained tweaks." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource OptionCard}" GroupName="Preset" IsChecked="{Binding Preset, Converter={StaticResource EnumEquals}, ConverterParameter=Trading}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Trading}" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Text="Trading" Style="{StaticResource CardTitle}" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Responsiveness while protecting trading apps." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </c:ResponsiveGrid>
                    <TextBlock Text="{Binding PresetDescription}" Style="{StaticResource Secondary}" Margin="0,12,0,0" />

                    <Border Style="{StaticResource Divider}" />
                    <c:ResponsiveGrid MinColumnWidth="280" MaxColumns="2" Spacing="{DynamicResource GridSpacing}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DryRun}">
                            <StackPanel>
                                <TextBlock Text="Dry run" FontWeight="SemiBold" />
                                <TextBlock Text="Show exactly what would change without changing anything." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CreateRestorePoint}">
                            <StackPanel>
                                <TextBlock Text="Create a Windows restore point" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RestorePointStatus}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                    </c:ResponsiveGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AnalyseCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Search}" Width="16" Height="16" />
                                <TextBlock Text="Analyse and propose changes" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Pipeline -->
            <Border Style="{StaticResource Card}" Visibility="{Binding CurrentStep, Converter={StaticResource Visible}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border x:Name="Dot" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource BgInset}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{x:Static local:StepReachedConverter.Instance}">
                                                <Binding Path="Number" />
                                                <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Accent}" />
                                        <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource AccentText}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,14,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Margin="12,0,0,0" />
                        <ProgressBar Value="{Binding Progress}" Maximum="100" VerticalAlignment="Center" AutomationProperties.Name="Optimisation progress" />
                    </DockPanel>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Secondary}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Proposed changes -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasPlan, Converter={StaticResource Visible}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}">
                            <TextBlock>
                                <Run Text="Apply selected (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Proposed changes" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="Nothing has been changed yet. Untick anything you do not want." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding PlanItems}" Focusable="False" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,10" Padding="16,14,16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,14,0"
                                                  AutomationProperties.Name="{Binding Title}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                            <WrapPanel Margin="0,6,0,6">
                                                <c:StatusBadge Text="{Binding Risk, Converter={StaticResource Friendly}}" Kind="{Binding Risk, Converter={StaticResource BadgeKind}}" Margin="0,0,6,4" />
                                                <c:StatusBadge Text="{Binding Reversibility, Converter={StaticResource Friendly}}" Kind="{Binding Reversibility, Converter={StaticResource BadgeKind}}" Margin="0,0,6,4" />
                                                <c:StatusBadge Text="{Binding Privilege, Converter={StaticResource Friendly}}" Kind="Neutral" Margin="0,0,6,4" />
                                                <c:StatusBadge Text="Needs your explicit approval" Kind="Warn" Margin="0,0,6,4" Visibility="{Binding RequiresExplicitApproval, Converter={StaticResource Visible}}" />
                                                <c:StatusBadge Text="Not applicable" Kind="Neutral" Margin="0,0,6,4" Visibility="{Binding CanSelect, Converter={StaticResource Collapsed}}" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" />
                                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Body}" Visibility="{Binding CanSelect, Converter={StaticResource Visible}}">
                                                <Run Text="Proposed: " FontWeight="SemiBold" /><Run Text="{Binding ProposedChange, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                            <Border Style="{StaticResource NoticeWarn}" Margin="0,8,0,0" Visibility="{Binding UncertaintyNote, Converter={StaticResource Visible}}">
                                                <TextBlock Text="{Binding UncertaintyNote}" Style="{StaticResource Body}" />
                                            </Border>
                                            <Expander Header="Preconditions" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Preconditions}" Style="{StaticResource Caption}" />
                                            </Expander>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Results -->
            <Border Style="{StaticResource Card}" Visibility="{Binding LastRun, Converter={StaticResource Visible}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding UndoLastRunCommand}" Visibility="{Binding CanUndoLastRun, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Undo}" Width="15" Height="15" />
                                <TextBlock Text="Undo this optimisation" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Optimisation report" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <c:StatusBadge DockPanel.Dock="Right" Text="{Binding Status, Converter={StaticResource Friendly}}" Kind="{Binding Status, Converter={StaticResource BadgeKind}}" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding VerificationMessage}" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="{Binding VerificationMessage, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding Deltas.Count, Converter={StaticResource Visible}}" Margin="0,8,0,0">
                        <TextBlock Text="Before and after (measured)" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Deltas}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding Before, Mode=OneWay, StringFormat='{}{0:0.#}'}" /><Run Text=" → " /><Run Text="{Binding After, Mode=OneWay, StringFormat='{}{0:0.#}'}" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <c:ComparisonBars Grid.Column="1" Before="{Binding Before, TargetNullValue=0}" After="{Binding After, TargetNullValue=0}" Margin="10,4,10,0"
                                                          BeforeBrush="{DynamicResource LineStrong}" AfterBrush="{DynamicResource Accent}" />
                                        <c:StatusBadge Grid.Column="2" Text="{Binding Assessment, Converter={StaticResource Friendly}}" Kind="{Binding Assessment, Converter={StaticResource BadgeKind}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Caveats}" Focusable="False" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Items that need a person's judgement -->
            <Border Style="{StaticResource Card}" Visibility="{Binding ReviewItems.Count, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="Worth reviewing yourself" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="These come from your last analysis. They need your judgement, so they are never applied automatically." Style="{StaticResource Caption}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ReviewItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                Command="{Binding DataContext.OpenReviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Issue}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Evidence}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
