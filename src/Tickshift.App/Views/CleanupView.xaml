<UserControl x:Class="Tickshift.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tickshift.App.Controls"
             xmlns:local="clr-namespace:Tickshift.App.Views">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding ScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                        <TextBlock Text="Rescan" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="System Cleanup" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Frees disk space from recognised disposable files only. Documents, Downloads, Desktop, pictures and browser profiles are never touched." />
                </StackPanel>
            </DockPanel>

            <local:PageStatus />

            <Border Style="{StaticResource NoticeWarn}" Visibility="{Binding TradingActive, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource Body}" Text="Trading Mode is active, so cleanup is deferred to avoid disk activity while you trade." />
            </Border>

            <!-- Storage overview -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Storage" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Margin="0,6,0,0" AutomationProperties.Name="{Binding Name}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Low}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="Open Storage Sense" Command="{Binding OpenLinkCommand}" CommandParameter="storage-sense" Margin="0,0,10,6" />
                        <Button Content="Open Windows Disk Cleanup" Command="{Binding OpenLinkCommand}" CommandParameter="disk-cleanup" Margin="0,0,10,6" />
                        <Button Content="Installed apps" Command="{Binding OpenLinkCommand}" CommandParameter="apps" Margin="0,0,10,6" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Windows' own tools can also remove update leftovers and other system files that need administrator rights." />
                </StackPanel>
            </Border>

            <!-- Targets -->
            <ItemsControl ItemsSource="{Binding Targets}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                        <c:StatusBadge Text="Not reversible" Kind="Neutral" Margin="10,0,0,0" Visibility="{Binding Irreversible, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <c:Icon Data="{StaticResource Icon.Shield}" Width="13" Height="13" Foreground="{DynamicResource Good}" />
                                        <TextBlock Text="{Binding Safety}" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="130">
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource BigValue}" FontSize="20" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="180" />
                                    <Button Content="Clean…" HorizontalAlignment="Right" Margin="0,8,0,0"
                                            Command="{Binding DataContext.CleanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanRun}" AutomationProperties.Name="{Binding Title}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource NoticeInfo}">
                <TextBlock Style="{StaticResource Secondary}"
                           Text="About RAM “cleaners”: TICKSHIFT deliberately does not include one. Tools that force apps to release memory only move data to disk and make Windows work harder a moment later. Closing apps and tabs you do not need is what really frees memory." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
