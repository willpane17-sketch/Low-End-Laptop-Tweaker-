<UserControl x:Class="Tickshift.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tickshift.App.Controls"
             xmlns:local="clr-namespace:Tickshift.App.Views">
    <DockPanel Margin="{DynamicResource PagePadding}">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Command="{Binding RestoreRecentCommand}" Visibility="{Binding RecentChanges, Converter={StaticResource Visible}}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Undo}" Width="14" Height="14" />
                            <TextBlock Margin="8,0,0,0">
                                <Run Text="Restore previous (" /><Run Text="{Binding RecentChanges, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadCommand}" AutomationProperties.Name="Refresh">
                        <c:Icon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Startup Manager" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <local:PageStatus />

            <Border Style="{StaticResource NoticeInfo}">
                <TextBlock Style="{StaticResource Secondary}"
                           Text="Disabling works exactly like Task Manager: the app stays installed and can still be opened; it just stops launching at sign-in. Nothing is disabled automatically, and unknown entries are never changed without you." />
            </Border>

            <DockPanel Margin="0,0,0,12">
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="StartupFilter" Content="All" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="StartupFilter" Content="Enabled" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Enabled}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="StartupFilter" Content="Disabled" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Disabled}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="StartupFilter" Content="Third-party" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=ThirdParty}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="StartupFilter" Content="Windows" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Windows}" />
                    </StackPanel>
                </Border>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="Search startup applications" ToolTip="Search by name, publisher or path" />
            </DockPanel>
        </StackPanel>

        <!-- Entries (virtualised list) -->
        <ListBox ItemsSource="{Binding Entries}" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Startup applications">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                <c:StatusBadge Text="{Binding Kind}" Kind="{Binding IsWindows, Converter={StaticResource BadgeKind}}" Margin="10,0,0,0" />
                                <c:StatusBadge Text="{Binding Signature, Converter={StaticResource Friendly}}" Kind="{Binding Signature, Converter={StaticResource BadgeKind}}" Margin="6,0,0,0" />
                                <c:StatusBadge Text="Needs administrator" Kind="Warn" Margin="6,0,0,0" Visibility="{Binding NeedsAdmin, Converter={StaticResource Visible}}" />
                                <c:StatusBadge Text="Program file missing" Kind="Bad" Margin="6,0,0,0" Visibility="{Binding Missing, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Publisher, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Mechanism, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ImpactText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Path}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" VerticalAlignment="Center" Margin="12,0,12,0" Foreground="{DynamicResource TextSecondary}" />
                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                  Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                  IsEnabled="{Binding IsWorking, Converter={StaticResource Not}}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Start {0} with Windows'}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
