<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Tickshift.App.Controls"
                    xmlns:vm="clr-namespace:Tickshift.App.ViewModels">

    <!-- Explained recommendation: Issue · Impact · Suggested action · Risk · Reversible · Why -->
    <DataTemplate x:Key="RecommendationCard" DataType="{x:Type vm:RecommendationItem}">
        <Border Style="{StaticResource Inset}" Margin="0,0,0,10" Padding="16,14,16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <c:StatusBadge Text="{Binding Model.Severity}" Kind="{Binding Model.Severity, Converter={StaticResource BadgeKind}}" Margin="0,0,6,4" />
                        <c:StatusBadge Text="{Binding Model.Risk, Converter={StaticResource Friendly}}" Kind="{Binding Model.Risk, Converter={StaticResource BadgeKind}}" Margin="0,0,6,4" />
                        <c:StatusBadge Text="{Binding Model.Reversible, Converter={StaticResource Friendly}}" Kind="{Binding Model.Reversible, Converter={StaticResource BadgeKind}}" Margin="0,0,6,4" />
                        <c:StatusBadge Text="Hardware limitation" Kind="Info" Margin="0,0,6,4" Visibility="{Binding Model.IsHardwareLimitation, Converter={StaticResource Visible}}" />
                        <c:StatusBadge Text="Deferred during Trading Mode" Kind="Warn" Margin="0,0,6,4" Visibility="{Binding Model.DeferredForTrading, Converter={StaticResource Visible}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Model.Issue}" Style="{StaticResource CardTitle}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Secondary}">
                        <Run Text="Impact: " FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" /><Run Text="{Binding Model.Impact, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}">
                        <Run Text="Suggested action: " FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" /><Run Text="{Binding Model.SuggestedAction, Mode=OneWay}" />
                    </TextBlock>
                    <Expander Header="Why am I seeing this?" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Model.Evidence}" Style="{StaticResource Caption}" />
                    </Expander>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top" Margin="14,0,0,0" Content="{Binding Model.ActionLabel}"
                        Command="{Binding Action}" CommandParameter="{Binding Model}"
                        Visibility="{Binding HasAction, Converter={StaticResource Visible}}" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
