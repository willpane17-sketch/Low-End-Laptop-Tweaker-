<UserControl x:Class="Tickshift.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tickshift.App.Controls"
             xmlns:local="clr-namespace:Tickshift.App.Views">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,18" Text="Every setting is saved immediately and kept after restarting." />

            <local:PageStatus />

            <!-- Appearance -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Theme" Style="{StaticResource Label}" />
                    <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Dark" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Light" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Follow Windows" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                        </StackPanel>
                    </Border>
                    <c:ResponsiveGrid MinColumnWidth="300" MaxColumns="2" Spacing="{DynamicResource GridSpacing}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CompactMode}">
                            <StackPanel>
                                <TextBlock Text="Compact interface" FontWeight="SemiBold" />
                                <TextBlock Text="Tighter spacing to fit more on small screens." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReducedMotion}">
                            <StackPanel>
                                <TextBlock Text="Reduce motion" FontWeight="SemiBold" />
                                <TextBlock Text="TICKSHIFT already avoids animation; this removes the remaining page transition." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                    </c:ResponsiveGrid>
                    <TextBlock Margin="0,14,0,0"><Run Text="Interface scale: " /><Run Text="{Binding UiScale, Mode=OneWay, StringFormat='{}{0:P0}'}" FontWeight="SemiBold" /></TextBlock>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="420" /><ColumnDefinition Width="0.01*" /></Grid.ColumnDefinitions><Slider Minimum="0.8" Maximum="1.5" TickFrequency="0.05" Value="{Binding UiScale}" AutomationProperties.Name="Interface scale" /></Grid>
                </StackPanel>
            </Border>

            <!-- Behaviour -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Behaviour" Style="{StaticResource SectionTitle}" />
                    <c:ResponsiveGrid MinColumnWidth="300" MaxColumns="2" Spacing="{DynamicResource GridSpacing}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LaunchWithWindows}">
                            <StackPanel>
                                <TextBlock Text="Launch with Windows" FontWeight="SemiBold" />
                                <TextBlock Text="Adds a visible entry you can see in Startup Manager and Task Manager." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimised}">
                            <StackPanel>
                                <TextBlock Text="Start minimised" FontWeight="SemiBold" />
                                <TextBlock Text="Start quietly in the notification area." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimiseToTray}">
                            <StackPanel>
                                <TextBlock Text="Keep running when the window is closed" FontWeight="SemiBold" />
                                <TextBlock Text="Needed for monitoring, automation and Trading Mode alerts." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DryRunMode}">
                            <StackPanel>
                                <TextBlock Text="Dry-run mode" FontWeight="SemiBold" />
                                <TextBlock Text="Everywhere in the app, show what would change without changing anything." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OfferRestorePoint}">
                            <StackPanel>
                                <TextBlock Text="Offer a Windows restore point" FontWeight="SemiBold" />
                                <TextBlock Text="Pre-select restore point creation in One-Click Optimise." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                    </c:ResponsiveGrid>
                    <TextBlock Margin="0,14,0,0"><Run Text="Monitoring refresh interval: " /><Run Text="{Binding RefreshInterval, Mode=OneWay, StringFormat='{}{0:0} s'}" FontWeight="SemiBold" /></TextBlock>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="420" /><ColumnDefinition Width="0.01*" /></Grid.ColumnDefinitions><Slider Minimum="1" Maximum="30" TickFrequency="1" Value="{Binding RefreshInterval}" AutomationProperties.Name="Monitoring refresh interval" /></Grid>
                    <TextBlock Style="{StaticResource Caption}" Text="Longer intervals use slightly less processor time. While the window is hidden, TICKSHIFT samples every 10 seconds at most." />

                    <TextBlock Text="Default optimisation preset" Style="{StaticResource Label}" Margin="0,14,0,4" />
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="DefaultPreset" Content="Safe" IsChecked="{Binding DefaultPreset, Converter={StaticResource EnumEquals}, ConverterParameter=Safe}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="DefaultPreset" Content="Balanced" IsChecked="{Binding DefaultPreset, Converter={StaticResource EnumEquals}, ConverterParameter=Balanced}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="DefaultPreset" Content="Trading" IsChecked="{Binding DefaultPreset, Converter={StaticResource EnumEquals}, ConverterParameter=Trading}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,12">
                        <TextBlock Text="Allow notifications" FontWeight="SemiBold" />
                    </CheckBox>
                    <c:ResponsiveGrid MinColumnWidth="240" MaxColumns="3" Spacing="{DynamicResource GridSpacing}" IsEnabled="{Binding NotificationsEnabled}">
                        <CheckBox Content="Memory pressure" IsChecked="{Binding NotifyMemory}" />
                        <CheckBox Content="Temperature" IsChecked="{Binding NotifyThermal}" />
                        <CheckBox Content="Low storage" IsChecked="{Binding NotifyStorage}" />
                        <CheckBox Content="Trading Mode alerts" IsChecked="{Binding NotifyTrading}" />
                        <CheckBox Content="Recommendations" IsChecked="{Binding NotifyRecommendations}" />
                    </c:ResponsiveGrid>
                </StackPanel>
            </Border>

            <!-- Protection -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Trading protection" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ProtectedSummary}" Style="{StaticResource Secondary}" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Content="Protected applications…" Command="{Binding ManageProtectedCommand}" Margin="0,0,10,6" />
                        <Button Content="Protected websites…" Command="{Binding ManageWebsitesCommand}" Margin="0,0,10,6" />
                        <Button Content="Automation settings…" Command="{Binding ManageAutomationCommand}" Margin="0,0,10,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Data and privacy" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,10"
                               Text="TICKSHIFT works entirely offline. It collects no telemetry, reads no browsing history, passwords or trading account data, and keeps its files in one folder on this PC." />
                    <TextBlock Style="{StaticResource Caption}"><Run Text="Data folder: " /><Run Text="{Binding DataFolder, Mode=OneWay}" FontFamily="Consolas" /></TextBlock>
                    <TextBlock Margin="0,12,0,0"><Run Text="Keep history for: " /><Run Text="{Binding RetentionDays, Mode=OneWay, StringFormat='{}{0:0} days'}" FontWeight="SemiBold" /></TextBlock>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="420" /><ColumnDefinition Width="0.01*" /></Grid.ColumnDefinitions><Slider Minimum="1" Maximum="365" TickFrequency="1" Value="{Binding RetentionDays}" AutomationProperties.Name="History retention in days" /></Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Apply retention now" Command="{Binding ApplyRetentionCommand}" Margin="0,0,10,6" />
                        <Button Command="{Binding ExportReportCommand}" Margin="0,0,10,6">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Export}" Width="14" Height="14" />
                                <TextBlock Text="Export diagnostic report" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Content="Reset application settings…" Command="{Binding ResetCommand}" Margin="0,0,10,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PrivilegeText}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Text="TICKSHIFT improves what software can improve. It cannot fix hardware limits and does not guarantee faster trade execution. It never disables Windows security features." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
