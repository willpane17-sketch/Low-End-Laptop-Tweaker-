<UserControl x:Class="Tickshift.App.Views.ThermalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tickshift.App.Controls"
             xmlns:local="clr-namespace:Tickshift.App.Views">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Text="Thermal Monitor" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,18"
                       Text="Temperature, cooling behaviour and heat-related symptoms. TICKSHIFT never overrides thermal protection, fan control or power limits." />

            <local:PageStatus />

            <Border Style="{StaticResource HeroCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="92" Height="92" CornerRadius="46" Background="{DynamicResource BgInset}" VerticalAlignment="Top">
                        <c:Icon Data="{StaticResource Icon.Thermometer}" Width="40" Height="40">
                            <c:Icon.Style>
                                <Style TargetType="c:Icon">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Normal"><Setter Property="Foreground" Value="{DynamicResource Good}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Elevated"><Setter Property="Foreground" Value="{DynamicResource Warn}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="High"><Setter Property="Foreground" Value="{DynamicResource Bad}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource Bad}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </c:Icon.Style>
                        </c:Icon>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TemperatureText}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold" />
                            <c:StatusBadge Text="{Binding State}" Kind="{Binding State, Converter={StaticResource BadgeKind}}" Margin="14,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding UnavailableExplanation}" Style="{StaticResource Secondary}" Margin="0,6,0,0" Visibility="{Binding UnavailableExplanation, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <c:ResponsiveGrid MinColumnWidth="220" MaxColumns="4" Spacing="{DynamicResource GridSpacing}" Margin="{DynamicResource CardMargin}">
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="TREND" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding TrendText}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="FIRMWARE COOLING LIMIT" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding PassiveLimitText}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="PROCESSOR SPEED" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding PerformanceText}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="POWER" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding PowerText}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </c:ResponsiveGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="ThermalWindow" Content="5 min" IsChecked="{Binding SelectedWindow, Converter={StaticResource EnumEquals}, ConverterParameter=FiveMinutes}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ThermalWindow" Content="30 min" IsChecked="{Binding SelectedWindow, Converter={StaticResource EnumEquals}, ConverterParameter=ThirtyMinutes}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ThermalWindow" Content="1 hour" IsChecked="{Binding SelectedWindow, Converter={StaticResource EnumEquals}, ConverterParameter=OneHour}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ThermalWindow" Content="Session" IsChecked="{Binding SelectedWindow, Converter={StaticResource EnumEquals}, ConverterParameter=Session}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Temperature and processor load" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
                    </DockPanel>
                    <c:PerformanceChart Height="{DynamicResource ChartHeight}" Samples="{Binding ChartSamples}" ShowCpu="True" ShowMemory="False" ShowTemperature="{Binding SensorAvailable}"
                                        CpuBrush="{DynamicResource ChartCpu}" TemperatureBrush="{DynamicResource ChartTemp}" GridBrush="{DynamicResource ChartGrid}" LabelBrush="{DynamicResource TextMuted}"
                                        AutomationProperties.Name="Temperature and processor load chart" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Temperature is plotted on the same 0–100 scale (°C). Gaps mean no reading was available." />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding ThresholdText}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Thermal diagnosis" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="No heat-related symptoms detected right now." Style="{StaticResource Secondary}" Visibility="{Binding Insights.Count, Converter={StaticResource Collapsed}}" />
                    <ItemsControl ItemsSource="{Binding Insights}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <c:StatusBadge Text="{Binding Severity}" Kind="{Binding Severity, Converter={StaticResource BadgeKind}}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Suggestion}" Style="{StaticResource Body}" Foreground="{DynamicResource Accent}" Margin="0,6,0,0" Visibility="{Binding Suggestion, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Practical cooling tips" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding HardwareTips}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <c:Icon Data="{StaticResource Icon.Check}" Width="14" Height="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource Secondary}" Margin="10,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding FanText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
