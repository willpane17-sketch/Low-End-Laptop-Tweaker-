<UserControl x:Class="Tickshift.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tickshift.App.Controls"
             xmlns:local="clr-namespace:Tickshift.App.Views"
             Background="{DynamicResource BgWindow}">
    <Grid>
        <Border Background="{DynamicResource HeroGradient}" Opacity="0.7" />
        <ScrollViewer Style="{StaticResource PageScroll}">
            <Border MaxWidth="780" Margin="24,48,24,32" VerticalAlignment="Center" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource LineSubtle}"
                    BorderThickness="1" CornerRadius="16" Padding="36,30,36,26">
                <DockPanel>
                    <!-- Header -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,22">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StepLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoft}">
                                <c:Icon Data="{StaticResource Icon.Trading}" Width="17" Height="17" Foreground="{DynamicResource Accent}" />
                            </Border>
                            <TextBlock Text="{Binding ProductName}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Footer -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,26,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Back" Command="{Binding BackCommand}" Visibility="{Binding IsFirst, Converter={StaticResource Collapsed}}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding NextText}" Command="{Binding NextCommand}" IsDefault="True"
                                    IsEnabled="{Binding Scanning, Converter={StaticResource Not}}" />
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Content="Skip setup" Command="{Binding SkipCommand}" HorizontalAlignment="Left" />
                    </DockPanel>

                    <Grid>
                        <!-- 0: Welcome -->
                        <StackPanel Visibility="{Binding Step, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=0}">
                            <TextBlock Text="Welcome to TICKSHIFT" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Tagline}" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,6,0,16" />
                            <TextBlock Style="{StaticResource Secondary}" FontSize="14"
                                       Text="TICKSHIFT helps older and budget laptops stay responsive — especially while you trade with MetaTrader, TradingView and your broker's platform. Setup takes about a minute." />
                        </StackPanel>

                        <!-- 1: Purpose and limitations -->
                        <StackPanel Visibility="{Binding Step, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=1}">
                            <TextBlock Text="What TICKSHIFT can — and can't — do" Style="{StaticResource PageTitle}" />
                            <c:ResponsiveGrid MinColumnWidth="280" MaxColumns="2" Spacing="16" Margin="0,16,0,0">
                                <Border Style="{StaticResource NoticeGood}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="It can" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Style="{StaticResource Body}" Text="• Find what is slowing your laptop down&#x0a;• Trim startup apps and background load&#x0a;• Guide browser settings for lighter tabs&#x0a;• Keep trading apps protected and monitored&#x0a;• Measure honestly, before and after" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource NoticeWarn}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="It can't" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBlock Style="{StaticResource Body}" Text="• Add memory, a faster drive or a faster processor&#x0a;• Make your broker execute orders faster&#x0a;• Fix failing hardware or poor cooling&#x0a;• Guarantee a percentage speed-up" />
                                    </StackPanel>
                                </Border>
                            </c:ResponsiveGrid>
                        </StackPanel>

                        <!-- 2: Hardware -->
                        <StackPanel Visibility="{Binding Step, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=2}">
                            <TextBlock Text="Your laptop" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Detected using Windows' own information — nothing leaves this PC." Style="{StaticResource PageSubtitle}" Margin="0,4,0,14" />
                            <TextBlock Text="Detecting hardware…" Style="{StaticResource Secondary}" Visibility="{Binding Detecting, Converter={StaticResource Visible}}" />
                            <StackPanel Visibility="{Binding Detecting, Converter={StaticResource Collapsed}}">
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Data="{StaticResource Icon.Cpu}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource Body}" Margin="12,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <c:ResponsiveGrid MinColumnWidth="200" MaxColumns="2" Spacing="8">
                                    <Border Style="{StaticResource Inset}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Data="{StaticResource Icon.Memory}" Foreground="{DynamicResource Accent}" />
                                            <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Body}" Margin="12,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Inset}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Data="{StaticResource Icon.Storage}" Foreground="{DynamicResource Accent}" />
                                            <TextBlock Text="{Binding StorageText}" Style="{StaticResource Body}" Margin="12,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Inset}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Data="{StaticResource Icon.Window}" Foreground="{DynamicResource Accent}" />
                                            <TextBlock Text="{Binding WindowsText}" Style="{StaticResource Body}" Margin="12,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Inset}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Data="{StaticResource Icon.Battery}" Foreground="{DynamicResource Accent}" />
                                            <TextBlock Text="{Binding PowerText}" Style="{StaticResource Body}" Margin="12,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </c:ResponsiveGrid>
                                <ItemsControl ItemsSource="{Binding Insights}" Focusable="False" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4">
                                                <Run Text="• " /><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- 3: Primary use -->
                        <StackPanel Visibility="{Binding Step, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=3}">
                            <TextBlock Text="What do you mainly use this laptop for?" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="This sets sensible defaults. You can change everything later." Style="{StaticResource PageSubtitle}" Margin="0,4,0,14" />
                            <c:ResponsiveGrid MinColumnWidth="260" MaxColumns="2" Spacing="12">
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="Use" IsChecked="{Binding PrimaryUse, Converter={StaticResource EnumEquals}, ConverterParameter=Trading}">
                                    <StackPanel>
                                        <TextBlock Text="Trading" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="MetaTrader, TradingView, broker terminals." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="Use" IsChecked="{Binding PrimaryUse, Converter={StaticResource EnumEquals}, ConverterParameter=Productivity}">
                                    <StackPanel>
                                        <TextBlock Text="General productivity" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Office apps, email and documents." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="Use" IsChecked="{Binding PrimaryUse, Converter={StaticResource EnumEquals}, ConverterParameter=Browsing}">
                                    <StackPanel>
                                        <TextBlock Text="Browsing" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Mostly Edge or Chrome." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource OptionCard}" GroupName="Use" IsChecked="{Binding PrimaryUse, Converter={StaticResource EnumEquals}, ConverterParameter=Balanced}">
                                    <StackPanel>
                                        <TextBlock Text="A bit of everything" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Balanced defaults." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </RadioButton>
                            </c:ResponsiveGrid>
                        </StackPanel>

                        <!-- 4: Protected apps -->
                        <StackPanel Visibility="{Binding Step, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=4}">
                            <TextBlock Text="Which apps should never be interrupted?" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Protected apps are never closed or restarted by TICKSHIFT, and Trading Mode reports on them." Style="{StaticResource PageSubtitle}" Margin="0,4,0,14" />
                            <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                            <DockPanel>
                                                <c:StatusBadge DockPanel.Dock="Right" Text="{Binding Status}" Kind="{Binding IsRunning, Converter={StaticResource BadgeKind}}" Margin="10,0,0,0" />
                                                <CheckBox IsChecked="{Binding IsProtected}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="You can add custom programs, such as a broker's own terminal, in Trading Mode later." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- 5: Safety -->
                        <StackPanel Visibility="{Binding Step, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=5}">
                            <TextBlock Text="Safe by design" Style="{StaticResource PageTitle}" />
                            <StackPanel Margin="0,16,0,0">
                                <DockPanel Margin="0,0,0,12">
                                    <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <TextBlock Style="{StaticResource Body}" Text="You always see every change, its risk and whether it can be undone — before anything happens. Dry-run mode lets you preview without changing anything." />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Shield}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <TextBlock Style="{StaticResource Body}" Text="Original settings are recorded first. Changes are verified afterwards and can be undone from the Recovery Centre. A Windows restore point can also be created." />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Lock}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <TextBlock Style="{StaticResource Body}" Text="Windows Defender, Firewall, updates, UAC and SmartScreen are never touched. TICKSHIFT runs without administrator rights and asks only when a specific action needs them." />
                                </DockPanel>
                                <DockPanel>
                                    <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Info}" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <TextBlock Style="{StaticResource Body}" Text="No telemetry, no accounts, no internet required. Your passwords, browsing and trading data are never read." />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 6: Initial diagnostic -->
                        <StackPanel Visibility="{Binding Step, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=6}">
                            <TextBlock Text="Running your first check-up" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="A short, read-only scan. Nothing is changed." Style="{StaticResource PageSubtitle}" Margin="0,4,0,14" />
                            <ProgressBar Value="{Binding ScanProgress}" Maximum="100" AutomationProperties.Name="Initial scan progress" />
                            <TextBlock Text="{Binding ScanStage}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource Body}" Margin="0,14,0,0" />
                        </StackPanel>

                        <!-- 7: Ready -->
                        <StackPanel Visibility="{Binding Step, Converter={x:Static local:EqualsVisibilityConverter.Instance}, ConverterParameter=7}">
                            <TextBlock Text="Your dashboard is ready" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,14" />
                            <TextBlock Text="Top findings" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding TopFindings}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <c:Icon Data="{StaticResource Icon.Chevron}" Width="12" Height="12" Foreground="{DynamicResource Accent}" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="Open the dashboard for full explanations, or try One-Click Optimise with the preset chosen for you." />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
